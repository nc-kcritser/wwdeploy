Bootstrap: docker
From: nvcr.io/nvidia/cuda:12.8.0-devel-ubi9

%labels
    Maintainer HPC Team
    Version 1.0
    Description GPU benchmark container: NCCL, GEMM (cuBLAS)
    CUDA 12.8
    Fabrics IB, RoCE, Ethernet
    GPUs A100, H100, H200, B200, B300

%post
    set -e

    # --- Versions ---
    UCX_VERSION=1.17.0
    OMPI_VERSION=5.0.6
    NCCL_VERSION=2.22.3-1
    NCCL_TESTS_VERSION=2.13.11

    # --- Base packages ---
    dnf -y update
    dnf -y install epel-release
    dnf -y install \
        gcc gcc-c++ make cmake wget tar bzip2 gzip \
        python3 numactl numactl-devel hwloc hwloc-devel \
        libibverbs libibverbs-devel rdma-core rdma-core-devel \
        librdmacm librdmacm-devel libibumad libibumad-devel \
        infiniband-diags \
        openssh-clients \
        libevent libevent-devel zlib zlib-devel \
        flex bison which file hostname
    dnf clean all

    export CUDA_HOME=/usr/local/cuda
    export PATH=${CUDA_HOME}/bin:$PATH
    export LD_LIBRARY_PATH=${CUDA_HOME}/lib64:$LD_LIBRARY_PATH

    # --- UCX with CUDA + IB/RoCE support ---
    cd /tmp
    wget -q https://github.com/openucx/ucx/releases/download/v${UCX_VERSION}/ucx-${UCX_VERSION}.tar.gz
    tar xf ucx-${UCX_VERSION}.tar.gz
    cd ucx-${UCX_VERSION}
    ./configure \
        --prefix=/opt/ucx \
        --with-verbs \
        --with-rdmacm \
        --with-cuda=${CUDA_HOME} \
        --without-java \
        --enable-optimizations \
        --disable-logging \
        --disable-debug \
        --disable-assertions \
        --disable-params-check \
        > /dev/null
    make -j$(nproc) install
    cd /tmp && rm -rf ucx-${UCX_VERSION}*

    # --- PMIx ---
    cd /tmp
    wget -q https://github.com/pmix/pmix/releases/download/v4.2.9/pmix-4.2.9.tar.gz
    tar xf pmix-4.2.9.tar.gz
    cd pmix-4.2.9
    ./configure --prefix=/opt/pmix --with-libevent > /dev/null
    make -j$(nproc) install
    cd /tmp && rm -rf pmix-4.2.9*

    # --- OpenMPI with CUDA + UCX ---
    cd /tmp
    wget -q https://download.open-mpi.org/release/open-mpi/v5.0/openmpi-${OMPI_VERSION}.tar.gz
    tar xf openmpi-${OMPI_VERSION}.tar.gz
    cd openmpi-${OMPI_VERSION}
    ./configure \
        --prefix=/opt/openmpi \
        --with-ucx=/opt/ucx \
        --with-pmix=/opt/pmix \
        --with-verbs \
        --with-cuda=${CUDA_HOME} \
        --enable-shared \
        > /dev/null
    make -j$(nproc) install
    cd /tmp && rm -rf openmpi-${OMPI_VERSION}*

    export PATH=/opt/openmpi/bin:/opt/ucx/bin:$PATH
    export LD_LIBRARY_PATH=/opt/openmpi/lib:/opt/ucx/lib:/opt/pmix/lib:$LD_LIBRARY_PATH

    # --- NCCL ---
    # Install from NVIDIA repo
    dnf config-manager --add-repo https://developer.download.nvidia.com/compute/cuda/repos/rhel9/x86_64/cuda-rhel9.repo
    dnf -y install libnccl-${NCCL_VERSION}+cuda12.8 libnccl-devel-${NCCL_VERSION}+cuda12.8
    dnf clean all

    # Symlink for easier discovery
    ln -sf /usr/include/nccl.h /usr/local/cuda/include/nccl.h 2>/dev/null || true

    # --- NCCL Tests ---
    cd /tmp
    wget -q https://github.com/NVIDIA/nccl-tests/archive/refs/tags/v${NCCL_TESTS_VERSION}.tar.gz
    tar xf v${NCCL_TESTS_VERSION}.tar.gz
    cd nccl-tests-${NCCL_TESTS_VERSION}
    make -j$(nproc) \
        MPI=1 \
        MPI_HOME=/opt/openmpi \
        CUDA_HOME=${CUDA_HOME} \
        NCCL_HOME=/usr
    mkdir -p /opt/nccl-tests
    cp build/* /opt/nccl-tests/
    cd /tmp && rm -rf nccl-tests-* v${NCCL_TESTS_VERSION}.tar.gz

    # --- cuBLAS GEMM Benchmark ---
    mkdir -p /opt/gemm
    cat > /tmp/gemm_bench.cu << 'CUDASRC'
#include <cublas_v2.h>
#include <cuda_runtime.h>
#include <cuda_fp16.h>
#include <stdio.h>
#include <stdlib.h>

#define CHECK_CUDA(x) do { \
    cudaError_t e = (x); \
    if (e != cudaSuccess) { \
        fprintf(stderr, "CUDA error %s:%d: %s\n", __FILE__, __LINE__, cudaGetErrorString(e)); \
        exit(1); \
    } \
} while(0)

#define CHECK_CUBLAS(x) do { \
    cublasStatus_t e = (x); \
    if (e != CUBLAS_STATUS_SUCCESS) { \
        fprintf(stderr, "cuBLAS error %s:%d: %d\n", __FILE__, __LINE__, (int)e); \
        exit(1); \
    } \
} while(0)

int main(int argc, char **argv) {
    int M = 16384, N = 16384, K = 16384, iters = 20;

    if (argc > 1) M = N = K = atoi(argv[1]);
    if (argc > 2) iters = atoi(argv[2]);

    int dev;
    cudaDeviceProp prop;
    CHECK_CUDA(cudaGetDevice(&dev));
    CHECK_CUDA(cudaGetDeviceProperties(&prop, dev));

    printf("=== cuBLAS GEMM Benchmark ===\n");
    printf("GPU:        %s\n", prop.name);
    printf("Matrix:     %dx%dx%d (FP16 -> FP16)\n", M, N, K);
    printf("Iterations: %d\n", iters);

    size_t sizeA = (size_t)M * K * sizeof(__half);
    size_t sizeB = (size_t)K * N * sizeof(__half);
    size_t sizeC = (size_t)M * N * sizeof(__half);

    __half *dA, *dB, *dC;
    CHECK_CUDA(cudaMalloc(&dA, sizeA));
    CHECK_CUDA(cudaMalloc(&dB, sizeB));
    CHECK_CUDA(cudaMalloc(&dC, sizeC));

    cublasHandle_t handle;
    CHECK_CUBLAS(cublasCreate(&handle));
    CHECK_CUBLAS(cublasSetMathMode(handle, CUBLAS_TENSOR_OP_MATH));

    __half alpha = __float2half(1.0f), beta = __float2half(0.0f);

    /* Warmup */
    CHECK_CUBLAS(cublasHgemm(handle, CUBLAS_OP_N, CUBLAS_OP_N,
        M, N, K, &alpha, dA, M, dB, K, &beta, dC, M));
    CHECK_CUDA(cudaDeviceSynchronize());

    cudaEvent_t start, stop;
    CHECK_CUDA(cudaEventCreate(&start));
    CHECK_CUDA(cudaEventCreate(&stop));

    CHECK_CUDA(cudaEventRecord(start));
    for (int i = 0; i < iters; i++) {
        CHECK_CUBLAS(cublasHgemm(handle, CUBLAS_OP_N, CUBLAS_OP_N,
            M, N, K, &alpha, dA, M, dB, K, &beta, dC, M));
    }
    CHECK_CUDA(cudaEventRecord(stop));
    CHECK_CUDA(cudaEventSynchronize(stop));

    float ms = 0.0f;
    CHECK_CUDA(cudaEventElapsedTime(&ms, start, stop));

    double tflops = 2.0 * M * N * K * iters / ((ms / 1000.0) * 1e12);

    printf("Total time: %.2f ms\n", ms);
    printf("Avg/iter:   %.2f ms\n", ms / iters);
    printf("TFLOPS:     %.2f (FP16 Tensor)\n", tflops);

    cublasDestroy(handle);
    cudaFree(dA); cudaFree(dB); cudaFree(dC);
    return 0;
}
CUDASRC

    nvcc -O3 -arch=all \
        -o /opt/gemm/gemm_bench \
        /tmp/gemm_bench.cu \
        -lcublas
    rm -f /tmp/gemm_bench.cu

    # --- Cleanup ---
    rm -rf /tmp/*

%environment
    export CUDA_HOME=/usr/local/cuda
    export PATH=/opt/openmpi/bin:/opt/ucx/bin:/opt/nccl-tests:/opt/gemm:${CUDA_HOME}/bin:$PATH
    export LD_LIBRARY_PATH=/opt/openmpi/lib:/opt/ucx/lib:/opt/pmix/lib:${CUDA_HOME}/lib64:/usr/lib64:$LD_LIBRARY_PATH
    export UCX_TLS=rc,ud,tcp,sm,self,cuda_copy,cuda_ipc
    export UCX_NET_DEVICES=all
    export OMPI_MCA_btl=^openib
    export OMPI_MCA_pml=ucx
    export NCCL_IB_DISABLE=0
    export NCCL_DEBUG=WARN

%runscript
    echo "HPC GPU Benchmark Container (CUDA 12.8)"
    echo "Available benchmarks:"
    echo "  NCCL:  all_reduce_perf, all_gather_perf, reduce_scatter_perf, broadcast_perf"
    echo "  GEMM:  gemm_bench [matrix_size] [iterations]"
    echo ""
    echo "Usage: singularity exec --nv [--bind /dev/infiniband] hpc-bench-gpu.sif <benchmark> [args]"
    exec "$@"

%test
    nvidia-smi > /dev/null 2>&1 && echo "GPU:          OK" || echo "GPU:          NOT VISIBLE (expected without --nv)"
    test -x /opt/nccl-tests/all_reduce_perf && echo "NCCL tests:   OK"
    test -x /opt/gemm/gemm_bench             && echo "GEMM bench:   OK"
